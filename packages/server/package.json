{
  "name": "typstbook",
  "version": "0.2.5",
  "description": "A Storybook-like local workbench for Typst package authors",
  "type": "module",
  "license": "MIT",
  "author": "jiwonMe",
  "bin": {
    "typstbook": "dist/cli.js"
  },
  "files": [
    "dist",
    "helper",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiwonMe/typstbook.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/jiwonMe/typstbook/issues"
  },
  "homepage": "https://github.com/jiwonMe/typstbook#readme",
  "keywords": [
    "typst",
    "storybook",
    "preview",
    "cli",
    "workbench"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts dev",
    "build": "node scripts/build.mjs",
    "prepack": "pnpm --filter @typstbook/ui build && node scripts/build.mjs",
    "test": "tsx --test --test-force-exit src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.8",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
