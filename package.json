{
  "name": "@typstbook/workspace",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "tsx packages/server/src/cli.ts dev",
    "build": "pnpm --filter @typstbook/ui build && pnpm --filter typstbook build",
    "test": "pnpm --filter typstbook test",
    "typecheck": "pnpm --filter typstbook typecheck && pnpm --filter @typstbook/ui typecheck",
    "pack:check": "pnpm build && pnpm --filter typstbook pack --dry-run"
  },
  "devDependencies": {
    "tsx": "^4.20.3"
  }
}
