// Design tokens for demo-pkg. The workbench reads this module (and the package entrypoint) into the token browser.
#let palette = (
  info: (border: rgb("#239DAD"), bg: rgb("#e7f6f8")),
  warning: (border: rgb("#d97706"), bg: rgb("#fff7ed")),
  error: (border: rgb("#dc2626"), bg: rgb("#fef2f2")),
)

#let role-color = rgb("#555555")
#let code-fill = rgb("#f4f4f5")

#let space = (
  inset: 12pt,
  rule: 3pt,
  radius: 4pt,
  margin: 16pt,
  body: 11pt,
  title: 20pt,
  code: 8pt,
)

#let fonts = (
  body: "Libertinus Serif",
)
